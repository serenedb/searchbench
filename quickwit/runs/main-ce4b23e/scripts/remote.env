# Sourced on the host after run.env (N, TS, BOX, S3_PREFIX, DATA_PREFIX, WORK_CUTOFF_EPOCH, ...).
# Quickwit main ce4b23e, built on this box from source (setup.sh), no extra container env.
# Settings = the published Datadog BYOC run (runs/hippo-20261105), applied to both scales.
export HOME=/root
export PATH=/root/.cargo/bin:/srv/qw/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export AWS_DEFAULT_REGION=us-east-1 AWS_REGION=us-east-1
export RUST_TOOLCHAIN=1.97.1
export QW_SOURCE_REPO=https://github.com/quickwit-oss/quickwit
export QW_EXPECTED_REVISION=ce4b23eb52ba063bb72c22adc8226bfd42bc09ca
export QW_IMAGE=searchbench/quickwit:main-ce4b23e
export QW_PULL_IMAGE=no QW_EXTRA_ENV=
export QW_CLIENT_BIN=/srv/qw/source/quickwit/client/target/release/qw-parquet-ingest
export QW_INGEST=http SEARCHBENCH_LOAD_CLIENT=rust SEARCHBENCH_LOAD_PROCESSES=16
export QW_ENABLE_IN_MEMORY_INDEXING=true QW_CLUSTERING=on
export QW_MIN_SHARDS=48 QW_SHARD_THROUGHPUT_LIMIT=20mb QW_COMMIT_TIMEOUT_SECS=30 QW_SPLIT_NUM_DOCS=10000000
export QW_MERGE_POLICY=stable_log QW_VALIDATE_DOCS=off QW_INGEST_QUEUE_MEMORY=32GiB QW_INGEST_QUEUE_DISK=80GiB
export QW_MERGE_MAX_SECS=28800
export SEARCHBENCH_PYTHON=/srv/qw/venv/bin/python3
export SEARCHBENCH_CPU=on SEARCHBENCH_CPU_SLICE=searchbench.slice SEARCHBENCH_SKIP_DOWNLOAD=yes
export SEARCHBENCH_TRIES=3 SEARCHBENCH_QUERY_TIMEOUT=60 SEARCHBENCH_COLD_TIMEOUT=60 SEARCHBENCH_RESTART=yes
export DATA_MNT=/mnt/local
export SEARCHBENCH_DATA_ROOT=$DATA_MNT/corpus
export ROUNDS=3
export DATASETS="otel_logs_100m otel_logs_1b"
# BUCKET is appended at staging time by connect.sh (from local.env), not committed.
