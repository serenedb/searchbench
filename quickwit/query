#!/usr/bin/env bash
# Run one Quickwit query through the ES-compatible API; timing on stderr.
#
# stdin = one ES DSL body (the same dialect elastic/ uses). stdout = result rows.
# stderr last line = curl %{time_total}.
set -euo pipefail
: "${QW_PORT:=7280}"; : "${QW_INDEX:=otel_logs}"
Q="http://127.0.0.1:${QW_PORT}/api/v1/_elastic/${QW_INDEX}/_search"

q=$(cat)
if [[ "$q" == UNSUPPORTED:* ]]; then echo "${q#UNSUPPORTED: }" >&2; exit 3; fi

resp=$(curl -fsS -w '\n%{time_total}' -X POST "$Q" \
    -H 'Content-Type: application/json' --data-binary "$q")
rt=$(printf '%s\n' "$resp" | tail -n1)
body=$(printf '%s\n' "$resp" | sed '$d')

printf '%s' "$body" | python3 -c '
import sys, json
d = json.load(sys.stdin)
if "error" in d and "hits" not in d:
    print(json.dumps(d["error"])[:300], file=sys.stderr); sys.exit(1)
aggs = d.get("aggregations") or {}
if aggs:
    for name, a in aggs.items():
        for b in a.get("buckets", []):
            print(json.dumps({"key": b.get("key_as_string", b.get("key")),
                              "doc_count": b.get("doc_count")}))
elif d.get("hits", {}).get("hits"):
    for h in d["hits"]["hits"]:
        print(json.dumps(h.get("_source", h)))
else:
    t = d.get("hits", {}).get("total", {})
    print(t.get("value", 0) if isinstance(t, dict) else t)
'
printf '%s\n' "$rt" >&2
