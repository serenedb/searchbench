-- ArangoDB (AQL) tagged workload over otel_logs_view -- 92 queries mirroring
-- serenedb/queries_tagged.sql Q01-Q92 one-for-one (same task/filter/freq tags,
-- filters, windows, GROUP BY, ORDER BY and LIMIT) so the numbers line up.
-- One runnable AQL statement per line; the preceding `-- Qnn ...` comment
-- carries the tags verbatim (lib/benchmark.sh skips -- and blank lines and
-- parses task=/filter=/freq= from the tag line).
--
-- DIALECT MAPPING (SereneDB ts_* -> ArangoDB AQL, analyzer `seg` =
-- segmentation break=alpha case=lower, the faithful twin of SereneDB's
-- split-on-non-alpha + lowercase keyword dictionary):
--   term            -> ANALYZER(d.Body == 't', 'seg')
--   ts_all (AND)    -> ANALYZER(d.Body == 'a' AND d.Body == 'b', 'seg')
--   ts_any (OR)     -> ANALYZER(d.Body IN ['a','b'], 'seg')
--   minmatch(>=k)   -> ANALYZER(MIN_MATCH(c1, c2, ..., k), 'seg')
--   ts_phrase       -> PHRASE(d.Body, 'a b c', 'seg')
--   ## N (prox)     -> PHRASE(d.Body, 'a', N, 'b', 'seg')
--   ts_regexp/prefix-> ANALYZER(STARTS_WITH(d.Body, 'p'), 'seg') (prefix .*),
--                      ANALYZER(LIKE(d.Body, 'c_che'), 'seg') (single-char .)
--   ts_like         -> ANALYZER(LIKE(d.Body, 'conn%'), 'seg') (% / _ wildcards)
--   ts_levenshtein  -> ANALYZER(LEVENSHTEIN_MATCH(d.Body, 't', dist), 'seg')
--   NOT             -> ... AND NOT ANALYZER(d.Body == 'x', 'seg')
-- Timestamp is stored epoch-ms; windows use DATE_TIMESTAMP(...) (inclusive both
-- ends, mirroring SereneDB BETWEEN). Top-K scores with BM25(d, 1.2, 0.75)
-- (= the view's optimize_top_k bm25(1.2,0.75)). GROUP BY minute buckets on
-- FLOOR(Timestamp/60000)*60000. Self-joins iterate the view (a-side, full-text)
-- and probe the base collection by TraceId via its persistent index (b-side).

-- ============================ COUNT ============================
-- Q01 task=count filter=term freq=hi
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body == 'error', 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q02 task=count filter=term freq=lo
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body == 'payment', 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q03 task=count filter=and freq=hi (AND, 2 tokens)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body == 'failed' AND d.Body == 'order', 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q04 task=count filter=and freq=hi (AND, 4 tokens)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body == 'failed' AND d.Body == 'charge' AND d.Body == 'card' AND d.Body == 'cache', 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q05 task=count filter=and freq=lo (AND, 8 tokens)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body == 'failed' AND d.Body == 'send' AND d.Body == 'order' AND d.Body == 'confirmation' AND d.Body == 'email' AND d.Body == 'service' AND d.Body == 'expected' AND d.Body == 'post', 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q06 task=count filter=or freq=hi (OR, 2 tokens)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body IN ['error','failed'], 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q07 task=count filter=or freq=hi (OR, 4 tokens)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body IN ['connection','request','conversion','post'], 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q08 task=count filter=or freq=mid (OR, 8 tokens)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body IN ['payment','exception','refused','send','confirmation','email','expected','deadline'], 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q09 task=count filter=or,minmatch freq=hi (>=2 of 4)
FOR d IN otel_logs_view SEARCH ANALYZER(MIN_MATCH(d.Body == 'error', d.Body == 'failed', d.Body == 'charge', d.Body == 'cache', 2), 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q10 task=count filter=phrase freq=mid (phrase, 2 tokens)
FOR d IN otel_logs_view SEARCH PHRASE(d.Body, 'place order', 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q11 task=count filter=phrase freq=mid (phrase, 4 tokens)
FOR d IN otel_logs_view SEARCH PHRASE(d.Body, 'failed to place order', 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q12 task=count filter=phrase freq=lo (phrase, 8 tokens)
FOR d IN otel_logs_view SEARCH PHRASE(d.Body, 'post to email service expected 200 got 500', 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q13 task=count filter=phrase,proximity freq=hi (failed within 2 of order)
FOR d IN otel_logs_view SEARCH PHRASE(d.Body, 'failed', 2, 'order', 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q14 task=count filter=phrase,or freq=hi (phrase OR term)
FOR d IN otel_logs_view SEARCH (PHRASE(d.Body, 'failed to place order', 'seg') OR ANALYZER(d.Body == 'charge', 'seg')) COLLECT WITH COUNT INTO c RETURN c
-- Q15 task=count filter=phrase,and freq=mid (phrase AND term)
FOR d IN otel_logs_view SEARCH (PHRASE(d.Body, 'failed to place order', 'seg') AND ANALYZER(d.Body == 'charge', 'seg')) COLLECT WITH COUNT INTO c RETURN c
-- Q16 task=count filter=regexp freq=hi (charg.*)
FOR d IN otel_logs_view SEARCH ANALYZER(STARTS_WITH(d.Body, 'charg'), 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q17 task=count filter=regexp freq=hi (ord.*)
FOR d IN otel_logs_view SEARCH ANALYZER(STARTS_WITH(d.Body, 'ord'), 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q18 task=count filter=regexp freq=mid (conn.*)
FOR d IN otel_logs_view SEARCH ANALYZER(STARTS_WITH(d.Body, 'conn'), 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q19 task=count filter=regexp freq=hi (single-char wildcard mid: c.che -> cache)
FOR d IN otel_logs_view SEARCH ANALYZER(LIKE(d.Body, 'c_che'), 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q20 task=count filter=prefix freq=mid (conn)
FOR d IN otel_logs_view SEARCH ANALYZER(STARTS_WITH(d.Body, 'conn'), 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q21 task=count filter=prefix freq=hi (charg)
FOR d IN otel_logs_view SEARCH ANALYZER(STARTS_WITH(d.Body, 'charg'), 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q22 task=count filter=fuzzy freq=mid (levenshtein distance 1)
FOR d IN otel_logs_view SEARCH ANALYZER(LEVENSHTEIN_MATCH(d.Body, 'connection', 1), 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q23 task=count filter=fuzzy freq=mid (levenshtein distance 2)
FOR d IN otel_logs_view SEARCH ANALYZER(LEVENSHTEIN_MATCH(d.Body, 'connection', 2), 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q24 task=count filter=fuzzy,prefix freq=mid (levenshtein-2 AND prefix, same 'conn' root)
FOR d IN otel_logs_view SEARCH ANALYZER(LEVENSHTEIN_MATCH(d.Body, 'connection', 2) AND STARTS_WITH(d.Body, 'conn'), 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q25 task=count filter=like freq=mid (prefix wildcard conn%)
FOR d IN otel_logs_view SEARCH ANALYZER(LIKE(d.Body, 'conn%'), 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q26 task=count filter=like freq=hi (suffix wildcard %tion)
FOR d IN otel_logs_view SEARCH ANALYZER(LIKE(d.Body, '%tion'), 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q27 task=count filter=like freq=mid (middle wildcard %nnec%)
FOR d IN otel_logs_view SEARCH ANALYZER(LIKE(d.Body, '%nnec%'), 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q28 task=count filter=and,negation freq=hi (error but NOT cache)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body == 'error', 'seg') AND NOT ANALYZER(d.Body == 'cache', 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q29 task=count filter=or,negation freq=hi (error/failed, excluding charge)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body IN ['error','failed'], 'seg') AND NOT ANALYZER(d.Body == 'charge', 'seg') COLLECT WITH COUNT INTO c RETURN c
-- Q30 task=count filter=term,window freq=hi (term + Timestamp BETWEEN 6h)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body == 'error', 'seg') AND d.Timestamp >= DATE_TIMESTAMP('2025-09-23T00:00:00Z') AND d.Timestamp <= DATE_TIMESTAMP('2025-09-23T06:00:00Z') COLLECT WITH COUNT INTO c RETURN c
-- Q31 task=count filter=and,window freq=hi (term + service + Timestamp BETWEEN 6h)
FOR d IN otel_logs_view SEARCH d.ServiceName == 'frontend' AND ANALYZER(d.Body == 'failed', 'seg') AND d.Timestamp >= DATE_TIMESTAMP('2025-09-23T00:00:00Z') AND d.Timestamp <= DATE_TIMESTAMP('2025-09-23T06:00:00Z') COLLECT WITH COUNT INTO c RETURN c
-- Q32 task=count filter=or,window freq=mid (8-token OR within a BETWEEN 6h window)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body IN ['payment','exception','refused','send','confirmation','email','expected','deadline'], 'seg') AND d.Timestamp >= DATE_TIMESTAMP('2025-09-23T00:00:00Z') AND d.Timestamp <= DATE_TIMESTAMP('2025-09-23T06:00:00Z') COLLECT WITH COUNT INTO c RETURN c

-- ============================ TOP-K (BM25 score DESC, LIMIT 100) ============================
-- Q33 task=top_k filter=term freq=hi
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body == 'charge', 'seg') SORT BM25(d, 1.2, 0.75) DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, Body: d.Body, score: BM25(d, 1.2, 0.75)}
-- Q34 task=top_k filter=term freq=mid
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body == 'connection', 'seg') SORT BM25(d, 1.2, 0.75) DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, Body: d.Body, score: BM25(d, 1.2, 0.75)}
-- Q35 task=top_k filter=term freq=lo
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body == 'payment', 'seg') SORT BM25(d, 1.2, 0.75) DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, Body: d.Body, score: BM25(d, 1.2, 0.75)}
-- Q36 task=top_k filter=and freq=hi (AND, 2 tokens)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body == 'failed' AND d.Body == 'order', 'seg') SORT BM25(d, 1.2, 0.75) DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, Body: d.Body, score: BM25(d, 1.2, 0.75)}
-- Q37 task=top_k filter=and freq=hi (AND, 4 tokens)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body == 'failed' AND d.Body == 'charge' AND d.Body == 'card' AND d.Body == 'cache', 'seg') SORT BM25(d, 1.2, 0.75) DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, Body: d.Body, score: BM25(d, 1.2, 0.75)}
-- Q38 task=top_k filter=and freq=lo (AND, 8 tokens)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body == 'failed' AND d.Body == 'send' AND d.Body == 'order' AND d.Body == 'confirmation' AND d.Body == 'email' AND d.Body == 'service' AND d.Body == 'expected' AND d.Body == 'post', 'seg') SORT BM25(d, 1.2, 0.75) DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, Body: d.Body, score: BM25(d, 1.2, 0.75)}
-- Q39 task=top_k filter=or freq=hi (OR, 2 tokens)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body IN ['error','failed'], 'seg') SORT BM25(d, 1.2, 0.75) DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, Body: d.Body, score: BM25(d, 1.2, 0.75)}
-- Q40 task=top_k filter=or freq=hi (OR, 4 tokens)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body IN ['connection','request','conversion','post'], 'seg') SORT BM25(d, 1.2, 0.75) DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, Body: d.Body, score: BM25(d, 1.2, 0.75)}
-- Q41 task=top_k filter=or freq=mid (OR, 8 tokens)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body IN ['payment','exception','refused','send','confirmation','email','expected','deadline'], 'seg') SORT BM25(d, 1.2, 0.75) DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, Body: d.Body, score: BM25(d, 1.2, 0.75)}
-- Q42 task=top_k filter=or,minmatch freq=hi (>=2 of 4)
FOR d IN otel_logs_view SEARCH ANALYZER(MIN_MATCH(d.Body == 'error', d.Body == 'failed', d.Body == 'charge', d.Body == 'cache', 2), 'seg') SORT BM25(d, 1.2, 0.75) DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, Body: d.Body, score: BM25(d, 1.2, 0.75)}
-- Q43 task=top_k filter=phrase freq=mid (phrase, 2 tokens)
FOR d IN otel_logs_view SEARCH PHRASE(d.Body, 'place order', 'seg') SORT BM25(d, 1.2, 0.75) DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, Body: d.Body, score: BM25(d, 1.2, 0.75)}
-- Q44 task=top_k filter=phrase freq=mid (phrase, 4 tokens)
FOR d IN otel_logs_view SEARCH PHRASE(d.Body, 'failed to place order', 'seg') SORT BM25(d, 1.2, 0.75) DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, Body: d.Body, score: BM25(d, 1.2, 0.75)}
-- Q45 task=top_k filter=phrase freq=lo (phrase, 8 tokens)
FOR d IN otel_logs_view SEARCH PHRASE(d.Body, 'post to email service expected 200 got 500', 'seg') SORT BM25(d, 1.2, 0.75) DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, Body: d.Body, score: BM25(d, 1.2, 0.75)}
-- Q46 task=top_k filter=regexp freq=mid (conn.*)
FOR d IN otel_logs_view SEARCH ANALYZER(STARTS_WITH(d.Body, 'conn'), 'seg') SORT BM25(d, 1.2, 0.75) DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, Body: d.Body, score: BM25(d, 1.2, 0.75)}
-- Q47 task=top_k filter=prefix freq=hi (charg)
FOR d IN otel_logs_view SEARCH ANALYZER(STARTS_WITH(d.Body, 'charg'), 'seg') SORT BM25(d, 1.2, 0.75) DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, Body: d.Body, score: BM25(d, 1.2, 0.75)}
-- Q48 task=top_k filter=fuzzy freq=mid (levenshtein distance 1)
FOR d IN otel_logs_view SEARCH ANALYZER(LEVENSHTEIN_MATCH(d.Body, 'connection', 1), 'seg') SORT BM25(d, 1.2, 0.75) DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, Body: d.Body, score: BM25(d, 1.2, 0.75)}
-- Q49 task=top_k filter=fuzzy freq=mid (levenshtein distance 2)
FOR d IN otel_logs_view SEARCH ANALYZER(LEVENSHTEIN_MATCH(d.Body, 'connection', 2), 'seg') SORT BM25(d, 1.2, 0.75) DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, Body: d.Body, score: BM25(d, 1.2, 0.75)}
-- Q50 task=top_k filter=like freq=mid (prefix wildcard conn%)
FOR d IN otel_logs_view SEARCH ANALYZER(LIKE(d.Body, 'conn%'), 'seg') SORT BM25(d, 1.2, 0.75) DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, Body: d.Body, score: BM25(d, 1.2, 0.75)}
-- Q51 task=top_k filter=phrase,or freq=hi (phrase OR term)
FOR d IN otel_logs_view SEARCH (PHRASE(d.Body, 'failed to place order', 'seg') OR ANALYZER(d.Body == 'charge', 'seg')) SORT BM25(d, 1.2, 0.75) DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, Body: d.Body, score: BM25(d, 1.2, 0.75)}
-- Q52 task=top_k filter=and,negation freq=hi (error but NOT cache)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body == 'error', 'seg') AND NOT ANALYZER(d.Body == 'cache', 'seg') SORT BM25(d, 1.2, 0.75) DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, Body: d.Body, score: BM25(d, 1.2, 0.75)}
-- Q53 task=top_k filter=and,window freq=hi (term + service + Timestamp BETWEEN 6h)
FOR d IN otel_logs_view SEARCH d.ServiceName == 'payment' AND ANALYZER(d.Body == 'charge', 'seg') AND d.Timestamp >= DATE_TIMESTAMP('2025-09-23T00:00:00Z') AND d.Timestamp <= DATE_TIMESTAMP('2025-09-23T06:00:00Z') SORT BM25(d, 1.2, 0.75) DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, Body: d.Body, score: BM25(d, 1.2, 0.75)}

-- ============================ GROUP BY ============================
-- Q54 task=group_by filter=or freq=hi (key=SeverityText, ordered)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body IN ['error','failed'], 'seg') COLLECT sev = d.SeverityText WITH COUNT INTO cnt SORT cnt DESC RETURN {SeverityText: sev, cnt}
-- Q55 task=group_by filter=term freq=hi (key=SeverityText, ordered)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body == 'charge', 'seg') COLLECT sev = d.SeverityText WITH COUNT INTO cnt SORT cnt DESC RETURN {SeverityText: sev, cnt}
-- Q56 task=group_by filter=and freq=hi (key=SeverityText, NO order by)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body == 'failed' AND d.Body == 'order', 'seg') COLLECT sev = d.SeverityText WITH COUNT INTO cnt RETURN {SeverityText: sev, cnt}
-- Q57 task=group_by filter=or freq=hi (key=ScopeName, top 20 ordered)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body IN ['error','failed'], 'seg') COLLECT sn = d.ScopeName WITH COUNT INTO cnt SORT cnt DESC LIMIT 20 RETURN {ScopeName: sn, cnt}
-- Q58 task=group_by filter=regexp freq=hi (key=ScopeName)
FOR d IN otel_logs_view SEARCH ANALYZER(STARTS_WITH(d.Body, 'charg'), 'seg') COLLECT sn = d.ScopeName WITH COUNT INTO cnt SORT cnt DESC LIMIT 20 RETURN {ScopeName: sn, cnt}
-- Q59 task=group_by filter=fuzzy freq=mid (key=ScopeName)
FOR d IN otel_logs_view SEARCH ANALYZER(LEVENSHTEIN_MATCH(d.Body, 'connection', 1), 'seg') COLLECT sn = d.ScopeName WITH COUNT INTO cnt SORT cnt DESC LIMIT 20 RETURN {ScopeName: sn, cnt}
-- Q60 task=group_by filter=or freq=hi (key=ScopeName, NO order by)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body IN ['error','failed'], 'seg') COLLECT sn = d.ScopeName WITH COUNT INTO cnt RETURN {ScopeName: sn, cnt}
-- Q61 task=group_by filter=term freq=hi (key=minute)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body == 'error', 'seg') COLLECT minute = FLOOR(d.Timestamp / 60000) * 60000 WITH COUNT INTO cnt SORT minute RETURN {minute, cnt}
-- Q62 task=group_by filter=and freq=hi (key=minute)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body == 'failed' AND d.Body == 'order', 'seg') COLLECT minute = FLOOR(d.Timestamp / 60000) * 60000 WITH COUNT INTO cnt SORT minute RETURN {minute, cnt}
-- Q63 task=group_by filter=phrase freq=mid (key=minute)
FOR d IN otel_logs_view SEARCH PHRASE(d.Body, 'failed to place order', 'seg') COLLECT minute = FLOOR(d.Timestamp / 60000) * 60000 WITH COUNT INTO cnt SORT minute RETURN {minute, cnt}
-- Q64 task=group_by filter=or freq=hi (key=minute)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body IN ['error','failed','charge'], 'seg') COLLECT minute = FLOOR(d.Timestamp / 60000) * 60000 WITH COUNT INTO cnt SORT minute RETURN {minute, cnt}
-- Q65 task=group_by filter=term freq=hi (key=minute, NO order by)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body == 'error', 'seg') COLLECT minute = FLOOR(d.Timestamp / 60000) * 60000 WITH COUNT INTO cnt RETURN {minute, cnt}
-- Q66 task=group_by filter=and freq=hi (key=SeverityText, Body term + indexed service)
FOR d IN otel_logs_view SEARCH d.ServiceName == 'frontend' AND ANALYZER(d.Body == 'failed', 'seg') COLLECT sev = d.SeverityText WITH COUNT INTO cnt SORT cnt DESC RETURN {SeverityText: sev, cnt}
-- Q67 task=group_by filter=or freq=hi (two keys: SeverityText, ScopeName)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body IN ['error','failed'], 'seg') COLLECT sev = d.SeverityText, sn = d.ScopeName WITH COUNT INTO cnt SORT cnt DESC LIMIT 20 RETURN {SeverityText: sev, ScopeName: sn, cnt}

-- ============================ RECENT (Timestamp BETWEEN window + ORDER BY Timestamp DESC LIMIT 100) ============================
-- Q68 task=recent filter=and,window freq=hi (recent failed-order logs from checkout)
FOR d IN otel_logs_view SEARCH d.ServiceName == 'checkout' AND ANALYZER(d.Body == 'failed' AND d.Body == 'order', 'seg') AND d.Timestamp >= DATE_TIMESTAMP('2025-09-23T00:00:00Z') AND d.Timestamp <= DATE_TIMESTAMP('2025-09-23T00:30:00Z') SORT d.Timestamp DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, SeverityText: d.SeverityText, Body: d.Body}
-- Q69 task=recent filter=or,window freq=hi (recent error/failed/charge, severity>=warn)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body IN ['error','failed','charge'], 'seg') AND d.SeverityNumber >= 13 AND d.Timestamp >= DATE_TIMESTAMP('2025-09-23T00:00:00Z') AND d.Timestamp <= DATE_TIMESTAMP('2025-09-23T00:30:00Z') SORT d.Timestamp DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, SeverityText: d.SeverityText, Body: d.Body}
-- Q70 task=recent filter=term,window freq=hi (recent error logs in a 6h window)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body == 'error', 'seg') AND d.Timestamp >= DATE_TIMESTAMP('2025-09-23T00:00:00Z') AND d.Timestamp <= DATE_TIMESTAMP('2025-09-23T06:00:00Z') SORT d.Timestamp DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, SeverityText: d.SeverityText, Body: d.Body}
-- Q71 task=recent filter=phrase,window freq=mid (recent 'failed to place order')
FOR d IN otel_logs_view SEARCH PHRASE(d.Body, 'failed to place order', 'seg') AND d.Timestamp >= DATE_TIMESTAMP('2025-09-23T00:00:00Z') AND d.Timestamp <= DATE_TIMESTAMP('2025-09-23T06:00:00Z') SORT d.Timestamp DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, SeverityText: d.SeverityText, Body: d.Body}
-- Q72 task=recent filter=and,window freq=hi (recent payment charges)
FOR d IN otel_logs_view SEARCH d.ServiceName == 'payment' AND ANALYZER(d.Body == 'charge', 'seg') AND d.Timestamp >= DATE_TIMESTAMP('2025-09-23T00:00:00Z') AND d.Timestamp <= DATE_TIMESTAMP('2025-09-23T00:30:00Z') SORT d.Timestamp DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, SeverityText: d.SeverityText, Body: d.Body}
-- Q73 task=recent filter=window (pure time-series tail: recent cart logs, no text search)
FOR d IN otel_logs_view SEARCH d.ServiceName == 'cart' AND d.Timestamp >= DATE_TIMESTAMP('2025-09-23T00:00:00Z') AND d.Timestamp <= DATE_TIMESTAMP('2025-09-23T00:30:00Z') SORT d.Timestamp DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, SeverityText: d.SeverityText, Body: d.Body}
-- Q74 task=recent filter=regexp,window freq=hi (recent charg* logs in a 6h window)
FOR d IN otel_logs_view SEARCH ANALYZER(STARTS_WITH(d.Body, 'charg'), 'seg') AND d.Timestamp >= DATE_TIMESTAMP('2025-09-23T00:00:00Z') AND d.Timestamp <= DATE_TIMESTAMP('2025-09-23T06:00:00Z') SORT d.Timestamp DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, SeverityText: d.SeverityText, Body: d.Body}
-- Q75 task=recent filter=or,window freq=mid (recent connection/request/conversion logs)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body IN ['connection','request','conversion'], 'seg') AND d.Timestamp >= DATE_TIMESTAMP('2025-09-23T00:00:00Z') AND d.Timestamp <= DATE_TIMESTAMP('2025-09-23T00:30:00Z') SORT d.Timestamp DESC LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, SeverityText: d.SeverityText, Body: d.Body}
-- ---- RECENT without ORDER BY (windowed filter + LIMIT only; mirrors Q68-Q75, no sort) ----
-- Q76 task=recent filter=and,window freq=hi (checkout failed&order, NO order by)
FOR d IN otel_logs_view SEARCH d.ServiceName == 'checkout' AND ANALYZER(d.Body == 'failed' AND d.Body == 'order', 'seg') AND d.Timestamp >= DATE_TIMESTAMP('2025-09-23T00:00:00Z') AND d.Timestamp <= DATE_TIMESTAMP('2025-09-23T00:30:00Z') LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, SeverityText: d.SeverityText, Body: d.Body}
-- Q77 task=recent filter=or,window freq=hi (error/failed/charge sev>=warn, NO order by)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body IN ['error','failed','charge'], 'seg') AND d.SeverityNumber >= 13 AND d.Timestamp >= DATE_TIMESTAMP('2025-09-23T00:00:00Z') AND d.Timestamp <= DATE_TIMESTAMP('2025-09-23T00:30:00Z') LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, SeverityText: d.SeverityText, Body: d.Body}
-- Q78 task=recent filter=term,window freq=hi (error 6h, NO order by)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body == 'error', 'seg') AND d.Timestamp >= DATE_TIMESTAMP('2025-09-23T00:00:00Z') AND d.Timestamp <= DATE_TIMESTAMP('2025-09-23T06:00:00Z') LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, SeverityText: d.SeverityText, Body: d.Body}
-- Q79 task=recent filter=phrase,window freq=mid (failed to place order 6h, NO order by)
FOR d IN otel_logs_view SEARCH PHRASE(d.Body, 'failed to place order', 'seg') AND d.Timestamp >= DATE_TIMESTAMP('2025-09-23T00:00:00Z') AND d.Timestamp <= DATE_TIMESTAMP('2025-09-23T06:00:00Z') LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, SeverityText: d.SeverityText, Body: d.Body}
-- Q80 task=recent filter=and,window freq=hi (payment charges, NO order by)
FOR d IN otel_logs_view SEARCH d.ServiceName == 'payment' AND ANALYZER(d.Body == 'charge', 'seg') AND d.Timestamp >= DATE_TIMESTAMP('2025-09-23T00:00:00Z') AND d.Timestamp <= DATE_TIMESTAMP('2025-09-23T00:30:00Z') LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, SeverityText: d.SeverityText, Body: d.Body}
-- Q81 task=recent filter=window (cart tail, NO order by, no text search)
FOR d IN otel_logs_view SEARCH d.ServiceName == 'cart' AND d.Timestamp >= DATE_TIMESTAMP('2025-09-23T00:00:00Z') AND d.Timestamp <= DATE_TIMESTAMP('2025-09-23T00:30:00Z') LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, SeverityText: d.SeverityText, Body: d.Body}
-- Q82 task=recent filter=regexp,window freq=hi (charg.* 6h, NO order by)
FOR d IN otel_logs_view SEARCH ANALYZER(STARTS_WITH(d.Body, 'charg'), 'seg') AND d.Timestamp >= DATE_TIMESTAMP('2025-09-23T00:00:00Z') AND d.Timestamp <= DATE_TIMESTAMP('2025-09-23T06:00:00Z') LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, SeverityText: d.SeverityText, Body: d.Body}
-- Q83 task=recent filter=or,window freq=mid (connection/request/conversion, NO order by)
FOR d IN otel_logs_view SEARCH ANALYZER(d.Body IN ['connection','request','conversion'], 'seg') AND d.Timestamp >= DATE_TIMESTAMP('2025-09-23T00:00:00Z') AND d.Timestamp <= DATE_TIMESTAMP('2025-09-23T00:30:00Z') LIMIT 100 RETURN {Timestamp: d.Timestamp, ServiceName: d.ServiceName, SeverityText: d.SeverityText, Body: d.Body}

-- ============================ JOIN (self-join on TraceId; count(DISTINCT a.TraceId); TraceId<>'' drops the empty bucket) ============================
-- Q84 task=join filter=term freq=hi (frontend 'failed' traces that also involve payment)
FOR a IN otel_logs_view SEARCH a.ServiceName == 'frontend' AND ANALYZER(a.Body == 'failed', 'seg') FILTER a.TraceId != '' FOR b IN otel_logs_view SEARCH b.TraceId == a.TraceId AND b.ServiceName == 'payment' COLLECT tid = a.TraceId COLLECT WITH COUNT INTO n RETURN n
-- Q85 task=join filter=or freq=hi
FOR a IN otel_logs_view SEARCH ANALYZER(a.Body IN ['error','failed'], 'seg') FILTER a.TraceId != '' FOR b IN otel_logs_view SEARCH b.TraceId == a.TraceId AND b.ServiceName == 'payment' COLLECT tid = a.TraceId COLLECT WITH COUNT INTO n RETURN n
-- Q86 task=join filter=phrase freq=mid
FOR a IN otel_logs_view SEARCH PHRASE(a.Body, 'failed to place order', 'seg') FILTER a.TraceId != '' FOR b IN otel_logs_view SEARCH b.TraceId == a.TraceId AND b.ServiceName == 'payment' COLLECT tid = a.TraceId COLLECT WITH COUNT INTO n RETURN n
-- Q87 task=join filter=regexp freq=hi
FOR a IN otel_logs_view SEARCH ANALYZER(STARTS_WITH(a.Body, 'charg'), 'seg') FILTER a.TraceId != '' FOR b IN otel_logs_view SEARCH b.TraceId == a.TraceId AND b.ServiceName == 'frontend' COLLECT tid = a.TraceId COLLECT WITH COUNT INTO n RETURN n
-- Q88 task=join filter=and freq=hi (failed&order traces that also involve cart)
FOR a IN otel_logs_view SEARCH ANALYZER(a.Body == 'failed' AND a.Body == 'order', 'seg') FILTER a.TraceId != '' FOR b IN otel_logs_view SEARCH b.TraceId == a.TraceId AND b.ServiceName == 'cart' COLLECT tid = a.TraceId COLLECT WITH COUNT INTO n RETURN n
-- Q89 task=join filter=or freq=mid
FOR a IN otel_logs_view SEARCH ANALYZER(a.Body IN ['connection','request'], 'seg') FILTER a.TraceId != '' FOR b IN otel_logs_view SEARCH b.TraceId == a.TraceId AND b.ServiceName == 'frontend' COLLECT tid = a.TraceId COLLECT WITH COUNT INTO n RETURN n
-- Q90 task=join filter=and freq=hi
FOR a IN otel_logs_view SEARCH ANALYZER(a.Body == 'charge' AND a.Body == 'request', 'seg') FILTER a.TraceId != '' FOR b IN otel_logs_view SEARCH b.TraceId == a.TraceId AND b.ServiceName == 'frontend' COLLECT tid = a.TraceId COLLECT WITH COUNT INTO n RETURN n
-- Q91 task=join filter=term freq=hi
FOR a IN otel_logs_view SEARCH ANALYZER(a.Body == 'order', 'seg') FILTER a.TraceId != '' FOR b IN otel_logs_view SEARCH b.TraceId == a.TraceId AND b.ServiceName == 'payment' COLLECT tid = a.TraceId COLLECT WITH COUNT INTO n RETURN n
-- Q92 task=join filter=prefix freq=hi
FOR a IN otel_logs_view SEARCH ANALYZER(STARTS_WITH(a.Body, 'charg'), 'seg') FILTER a.TraceId != '' FOR b IN otel_logs_view SEARCH b.TraceId == a.TraceId AND b.ServiceName == 'frontend' COLLECT tid = a.TraceId COLLECT WITH COUNT INTO n RETURN n
