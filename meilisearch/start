#!/usr/bin/env bash
# Launch Meilisearch container; idempotent via ./check
set -euo pipefail
cd "$(dirname "$0")"
: "${MEILI_PORT:=7700}"
: "${MEILI_DATA_DIR:=${PWD}/meili-data}"
: "${MEILI_IMAGE:=getmeili/meilisearch:v1.53.1}"
: "${MEILI_CONTAINER:=searchbench-meili}"
# Production mode requires >=16 bytes; an 11-byte key makes the server exit 1.
: "${MEILI_KEY:=searchbench-meili-master-key-01}"

if ./check >/dev/null 2>&1; then echo "Meilisearch already up on :${MEILI_PORT}"; ./configure-features; exit 0; fi
mkdir -p "$MEILI_DATA_DIR"; chmod a+rwX "$MEILI_DATA_DIR" 2>/dev/null || true

if docker inspect "$MEILI_CONTAINER" >/dev/null 2>&1 \
   && [[ "$(docker inspect -f '{{.Config.Image}}' "$MEILI_CONTAINER")" != "$MEILI_IMAGE" ]]; then
    echo "container was built from a different image; recreating for ${MEILI_IMAGE}"
    docker rm -f "$MEILI_CONTAINER" >/dev/null
fi
if docker inspect "$MEILI_CONTAINER" >/dev/null 2>&1; then
    docker start "$MEILI_CONTAINER" >/dev/null
else
    docker run -d --name "$MEILI_CONTAINER" --network host \
        -e "MEILI_MASTER_KEY=${MEILI_KEY}" -e MEILI_ENV=production -e MEILI_NO_ANALYTICS=true \
        -e "MEILI_HTTP_ADDR=0.0.0.0:${MEILI_PORT}" \
        -v "${MEILI_DATA_DIR}:/meili_data" "$MEILI_IMAGE" >/dev/null
fi
for _ in $(seq 1 180); do
    if ./check >/dev/null 2>&1; then ./configure-features; echo "Meilisearch up on :${MEILI_PORT} (backend=docker)"; exit 0; fi
    sleep 1
done
echo "Meilisearch did not become healthy within 180s." >&2
docker logs --tail 50 "$MEILI_CONTAINER" 2>&1 >&2 || true
exit 1
