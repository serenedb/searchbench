UNSUPPORTED: sort by _score: LogsQL has no relevance scoring (no BM25 pipe)
-- Q54 task=group_by filter=or freq=hi (key=SeverityText, ordered)
("error" OR "failed") | stats by (SeverityText) count() as cnt | sort by (cnt) desc | limit 100
-- Q55 task=group_by filter=term freq=hi (key=SeverityText, ordered)
"charge" | stats by (SeverityText) count() as cnt | sort by (cnt) desc | limit 100
-- Q56 task=group_by filter=and freq=hi (key=SeverityText, NO order by)
("failed" AND "order") | stats by (SeverityText) count() as cnt | sort by (cnt) desc | limit 100
-- Q57 task=group_by filter=or freq=hi (key=ScopeName, top 20 ordered)
("error" OR "failed") | stats by (ScopeName) count() as cnt | sort by (cnt) desc | limit 20
-- Q58 task=group_by filter=regexp freq=hi (key=ScopeName)
charg* | stats by (ScopeName) count() as cnt | sort by (cnt) desc | limit 20
-- Q59 task=group_by filter=fuzzy freq=mid (key=ScopeName)
UNSUPPORTED: fuzzy matching: LogsQL has no edit-distance operator
-- Q60 task=group_by filter=or freq=hi (key=ScopeName, NO order by)
("error" OR "failed") | stats by (ScopeName) count() as cnt | sort by (cnt) desc | limit 100
-- Q61 task=group_by filter=term freq=hi (key=minute)
"error" | stats by (_time:1m) count() as cnt | sort by (_time)
-- Q62 task=group_by filter=and freq=hi (key=minute)
("failed" AND "order") | stats by (_time:1m) count() as cnt | sort by (_time)
-- Q63 task=group_by filter=phrase freq=mid (key=minute)
"failed to place order" | stats by (_time:1m) count() as cnt | sort by (_time)
-- Q64 task=group_by filter=or freq=hi (key=minute)
("error" OR "failed" OR "charge") | stats by (_time:1m) count() as cnt | sort by (_time)
-- Q65 task=group_by filter=term freq=hi (key=minute, NO order by)
"error" | stats by (_time:1m) count() as cnt | sort by (_time)
-- Q66 task=group_by filter=and freq=hi (key=SeverityText, Body term + indexed service)
"failed" AND ServiceName:=frontend | stats by (SeverityText) count() as cnt | sort by (cnt) desc | limit 100
-- Q67 task=group_by filter=or freq=hi (two keys: SeverityText, ScopeName)
("error" OR "failed") | stats by (SeverityText) count() as cnt | sort by (cnt) desc | limit 100
-- Q68 task=recent filter=and,window freq=hi (recent failed-order logs from checkout)
("failed" AND "order") AND ServiceName:=checkout AND _time:[2025-09-23T00:00:00Z, 2025-09-23T00:30:00Z] | sort by (_time) desc | fields _time,ServiceName,SeverityText,_msg | limit 100
-- Q69 task=recent filter=or,window freq=hi (recent error/failed/charge, severity>=warn)
("error" OR "failed" OR "charge") AND SeverityNumber:>=13 AND _time:[2025-09-23T00:00:00Z, 2025-09-23T00:30:00Z] | sort by (_time) desc | fields _time,ServiceName,SeverityText,_msg | limit 100
-- Q70 task=recent filter=term,window freq=hi (recent error logs in a 6h window)
"error" AND _time:[2025-09-23T00:00:00Z, 2025-09-23T06:00:00Z] | sort by (_time) desc | fields _time,ServiceName,SeverityText,_msg | limit 100
-- Q71 task=recent filter=phrase,window freq=mid (recent 'failed to place order')
"failed to place order" AND _time:[2025-09-23T00:00:00Z, 2025-09-23T06:00:00Z] | sort by (_time) desc | fields _time,ServiceName,SeverityText,_msg | limit 100
-- Q72 task=recent filter=and,window freq=hi (recent payment charges)
"charge" AND ServiceName:=payment AND _time:[2025-09-23T00:00:00Z, 2025-09-23T00:30:00Z] | sort by (_time) desc | fields _time,ServiceName,SeverityText,_msg | limit 100
-- Q73 task=recent filter=window (pure time-series tail: recent cart logs, no text search)
ServiceName:=cart AND _time:[2025-09-23T00:00:00Z, 2025-09-23T00:30:00Z] | sort by (_time) desc | fields _time,ServiceName,SeverityText,_msg | limit 100
-- Q74 task=recent filter=regexp,window freq=hi (recent charg* logs in a 6h window)
charg* AND _time:[2025-09-23T00:00:00Z, 2025-09-23T06:00:00Z] | sort by (_time) desc | fields _time,ServiceName,SeverityText,_msg | limit 100
-- Q75 task=recent filter=or,window freq=mid (recent connection/request/conversion logs)
("connection" OR "request" OR "conversion") AND _time:[2025-09-23T00:00:00Z, 2025-09-23T00:30:00Z] | sort by (_time) desc | fields _time,ServiceName,SeverityText,_msg | limit 100
-- Q76 task=recent filter=and,window freq=hi (checkout failed&order, NO order by)
("failed" AND "order") AND ServiceName:=checkout AND _time:[2025-09-23T00:00:00Z, 2025-09-23T00:30:00Z] | limit 100 | fields _time,ServiceName,SeverityText,_msg
-- Q77 task=recent filter=or,window freq=hi (error/failed/charge sev>=warn, NO order by)
("error" OR "failed" OR "charge") AND SeverityNumber:>=13 AND _time:[2025-09-23T00:00:00Z, 2025-09-23T00:30:00Z] | limit 100 | fields _time,ServiceName,SeverityText,_msg
-- Q78 task=recent filter=term,window freq=hi (error 6h, NO order by)
"error" AND _time:[2025-09-23T00:00:00Z, 2025-09-23T06:00:00Z] | limit 100 | fields _time,ServiceName,SeverityText,_msg
-- Q79 task=recent filter=phrase,window freq=mid (failed to place order 6h, NO order by)
"failed to place order" AND _time:[2025-09-23T00:00:00Z, 2025-09-23T06:00:00Z] | limit 100 | fields _time,ServiceName,SeverityText,_msg
-- Q80 task=recent filter=and,window freq=hi (payment charges, NO order by)
"charge" AND ServiceName:=payment AND _time:[2025-09-23T00:00:00Z, 2025-09-23T00:30:00Z] | limit 100 | fields _time,ServiceName,SeverityText,_msg
-- Q81 task=recent filter=window (cart tail, NO order by, no text search)
ServiceName:=cart AND _time:[2025-09-23T00:00:00Z, 2025-09-23T00:30:00Z] | limit 100 | fields _time,ServiceName,SeverityText,_msg
-- Q82 task=recent filter=regexp,window freq=hi (charg.* 6h, NO order by)
charg* AND _time:[2025-09-23T00:00:00Z, 2025-09-23T06:00:00Z] | limit 100 | fields _time,ServiceName,SeverityText,_msg
-- Q83 task=recent filter=or,window freq=mid (connection/request/conversion, NO order by)
("connection" OR "request" OR "conversion") AND _time:[2025-09-23T00:00:00Z, 2025-09-23T00:30:00Z] | limit 100 | fields _time,ServiceName,SeverityText,_msg
