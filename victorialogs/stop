#!/usr/bin/env bash
# Stop VictoriaLogs container (idempotent); kept, not removed, so ./start resumes it
set -euo pipefail
cd "$(dirname "$0")"

: "${VL_CONTAINER:=searchbench-vl}"

if docker inspect "$VL_CONTAINER" >/dev/null 2>&1; then
    docker stop --time 60 "$VL_CONTAINER" >/dev/null 2>&1 || true
fi
