#!/usr/bin/env bash
# Print the Manticore daemon version, e.g. "29.0.2".
#
# The old probe used /cli?q=show+version, which returns PLAIN TEXT ("Query OK,
# 0 rows affected") rather than JSON and never carries the version at all -- so
# the jq pipeline always failed and every result was recorded as "unknown".
# /sql?mode=raw returns real JSON: an array whose .data lists one row per
# component (Daemon, Columnar, Secondary, Knn, Embeddings). Take Daemon's and
# keep only the semver, dropping the " <sha>@<buildstamp>" suffix.
set -euo pipefail
: "${MANTICORE_HTTP_PORT:=9308}"
curl -fsS --get "http://127.0.0.1:${MANTICORE_HTTP_PORT}/sql" \
     --data-urlencode 'mode=raw' --data-urlencode 'query=show version' 2>/dev/null \
  | jq -r '.[0].data[]? | select(.Component == "Daemon") | .Version' 2>/dev/null \
  | awk '{print $1}' \
  | grep . || echo unknown
