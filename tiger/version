#!/usr/bin/env bash
# Print pg_textsearch extension version (the engine's search implementation);
# "unknown" on failure.
set -euo pipefail
source "$(dirname "$0")/common.sh"

v=$("${PSQL[@]}" -tA -c \
    "SELECT extversion FROM pg_extension WHERE extname='pg_textsearch';" 2>/dev/null \
    | tr -d '[:space:]')
echo "${v:-unknown}"
