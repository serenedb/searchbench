#!/usr/bin/env bash
# Print the PostgreSQL server version (this adapter's engine IS Postgres; the
# full-text path is core tsvector/GIN, not an extension). "unknown" on failure.
set -euo pipefail
source "$(dirname "$0")/common.sh"

v=$("${PSQL[@]}" -tA -c "SHOW server_version;" 2>/dev/null | tr -d '[:space:]')
echo "${v:-unknown}"
