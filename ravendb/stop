#!/usr/bin/env bash
# Stop RavenDB container (idempotent); kept, not removed, so ./start resumes it
set -euo pipefail
cd "$(dirname "$0")"
: "${RAVEN_CONTAINER:=searchbench-raven}"
if docker inspect "$RAVEN_CONTAINER" >/dev/null 2>&1; then
    docker stop --time 60 "$RAVEN_CONTAINER" >/dev/null 2>&1 || true
fi
