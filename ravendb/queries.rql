-- RavenDB RQL workload over the OTel-logs corpus -- 92 queries mirroring
-- serenedb/queries.sql Q01-Q92 one-for-one. Generated from
-- elastic/queries.dsl by ravendb/translate.py; see that file for the
-- semantics (search/regex behaviour, facets, what is unsupported).

-- Q01 task=count filter=term freq=hi
from index 'Logs/Search' where search(Body, 'error') limit 0
-- Q02 task=count filter=term freq=lo
from index 'Logs/Search' where search(Body, 'payment') limit 0
-- Q03 task=count filter=and freq=hi (AND, 2 tokens)
from index 'Logs/Search' where search(Body, 'failed order', and) limit 0
-- Q04 task=count filter=and freq=hi (AND, 4 tokens)
from index 'Logs/Search' where search(Body, 'failed charge card cache', and) limit 0
-- Q05 task=count filter=and freq=lo (AND, 8 tokens)
from index 'Logs/Search' where search(Body, 'failed send order confirmation email service expected post', and) limit 0
-- Q06 task=count filter=or freq=hi (OR, 2 tokens)
from index 'Logs/Search' where search(Body, 'error failed') limit 0
-- Q07 task=count filter=or freq=hi (OR, 4 tokens)
from index 'Logs/Search' where search(Body, 'connection request conversion post') limit 0
-- Q08 task=count filter=or freq=mid (OR, 8 tokens)
from index 'Logs/Search' where search(Body, 'payment exception refused send confirmation email expected deadline') limit 0
-- Q09 task=count filter=or,minmatch freq=hi (>=2 of 4)
from index 'Logs/Search' where ((search(Body, 'error') and search(Body, 'failed')) or (search(Body, 'error') and search(Body, 'charge')) or (search(Body, 'error') and search(Body, 'cache')) or (search(Body, 'failed') and search(Body, 'charge')) or (search(Body, 'failed') and search(Body, 'cache')) or (search(Body, 'charge') and search(Body, 'cache'))) limit 0
-- Q10 task=count filter=phrase freq=mid (phrase, 2 tokens)
from index 'Logs/Search' where search(Body, '"place order"') limit 0
-- Q11 task=count filter=phrase freq=mid (phrase, 4 tokens)
from index 'Logs/Search' where search(Body, '"failed to place order"') limit 0
-- Q12 task=count filter=phrase freq=lo (phrase, 8 tokens)
from index 'Logs/Search' where search(Body, '"post to email service expected 200 got 500"') limit 0
-- Q13 task=count filter=phrase,proximity freq=hi (failed within 2 of order)
UNSUPPORTED: match_phrase with slop: RQL has no proximity operator
-- Q14 task=count filter=phrase,or freq=hi (phrase OR term)
from index 'Logs/Search' where (search(Body, '"failed to place order"') or search(Body, 'charge')) limit 0
-- Q15 task=count filter=phrase,and freq=mid (phrase AND term)
from index 'Logs/Search' where search(Body, '"failed to place order"') and search(Body, 'charge') limit 0
-- Q16 task=count filter=regexp freq=hi (charg.*)
from index 'Logs/Search' where search(Body, 'charg*') limit 0
-- Q17 task=count filter=regexp freq=hi (ord.*)
from index 'Logs/Search' where search(Body, 'ord*') limit 0
-- Q18 task=count filter=regexp freq=mid (conn.*)
from index 'Logs/Search' where search(Body, 'conn*') limit 0
-- Q19 task=count filter=regexp freq=hi (single-char wildcard mid: c.che -> cache)
from index 'Logs/Search' where regex(Body, '(^|[^a-z0-9])c.che([^a-z0-9]|$)') limit 0
-- Q20 task=count filter=prefix freq=mid (conn)
from index 'Logs/Search' where search(Body, 'conn*') limit 0
-- Q21 task=count filter=prefix freq=hi (charg)
from index 'Logs/Search' where search(Body, 'charg*') limit 0
-- Q22 task=count filter=fuzzy freq=mid (levenshtein distance 1)
UNSUPPORTED: fuzzy: Corax reports "Method 'Fuzzy' is not supported"
-- Q23 task=count filter=fuzzy freq=mid (levenshtein distance 2)
UNSUPPORTED: fuzzy: Corax reports "Method 'Fuzzy' is not supported"
-- Q24 task=count filter=fuzzy,prefix freq=mid (levenshtein-2 AND prefix, same 'conn' root)
UNSUPPORTED: fuzzy: Corax reports "Method 'Fuzzy' is not supported"
-- Q25 task=count filter=like freq=mid (prefix wildcard conn%)
from index 'Logs/Search' where search(Body, 'conn*') limit 0
-- Q26 task=count filter=like freq=hi (suffix wildcard %tion)
from index 'Logs/Search' where regex(Body, 'tion([^a-z0-9]|$)') limit 0
-- Q27 task=count filter=like freq=mid (middle wildcard %nnec%)
from index 'Logs/Search' where regex(Body, 'nnec') limit 0
-- Q28 task=count filter=and,negation freq=hi (error but NOT cache)
from index 'Logs/Search' where search(Body, 'error') and not (search(Body, 'cache')) limit 0
-- Q29 task=count filter=or,negation freq=hi (error/failed, excluding charge)
from index 'Logs/Search' where search(Body, 'error failed') and not (search(Body, 'charge')) limit 0
-- Q30 task=count filter=term,window freq=hi (term + Timestamp BETWEEN 6h)
from index 'Logs/Search' where search(Body, 'error') and Timestamp between '2025-09-23T00:00:00.0000000Z' and '2025-09-23T06:00:00.0000000Z' limit 0
-- Q31 task=count filter=and,window freq=hi (term + service + Timestamp BETWEEN 6h)
from index 'Logs/Search' where search(Body, 'failed') and ServiceName = 'frontend' and Timestamp between '2025-09-23T00:00:00.0000000Z' and '2025-09-23T06:00:00.0000000Z' limit 0
-- Q32 task=count filter=or,window freq=mid (8-token OR within a BETWEEN 6h window)
from index 'Logs/Search' where search(Body, 'payment exception refused send confirmation email expected deadline') and Timestamp between '2025-09-23T00:00:00.0000000Z' and '2025-09-23T06:00:00.0000000Z' limit 0
-- Q33 task=top_k filter=term freq=hi
from index 'Logs/Search' where search(Body, 'charge') order by score() select Timestamp, ServiceName, Body limit 100
-- Q34 task=top_k filter=term freq=mid
from index 'Logs/Search' where search(Body, 'connection') order by score() select Timestamp, ServiceName, Body limit 100
-- Q35 task=top_k filter=term freq=lo
from index 'Logs/Search' where search(Body, 'payment') order by score() select Timestamp, ServiceName, Body limit 100
-- Q36 task=top_k filter=and freq=hi (AND, 2 tokens)
from index 'Logs/Search' where search(Body, 'failed order', and) order by score() select Timestamp, ServiceName, Body limit 100
-- Q37 task=top_k filter=and freq=hi (AND, 4 tokens)
from index 'Logs/Search' where search(Body, 'failed charge card cache', and) order by score() select Timestamp, ServiceName, Body limit 100
-- Q38 task=top_k filter=and freq=lo (AND, 8 tokens)
from index 'Logs/Search' where search(Body, 'failed send order confirmation email service expected post', and) order by score() select Timestamp, ServiceName, Body limit 100
-- Q39 task=top_k filter=or freq=hi (OR, 2 tokens)
from index 'Logs/Search' where search(Body, 'error failed') order by score() select Timestamp, ServiceName, Body limit 100
-- Q40 task=top_k filter=or freq=hi (OR, 4 tokens)
from index 'Logs/Search' where search(Body, 'connection request conversion post') order by score() select Timestamp, ServiceName, Body limit 100
-- Q41 task=top_k filter=or freq=mid (OR, 8 tokens)
from index 'Logs/Search' where search(Body, 'payment exception refused send confirmation email expected deadline') order by score() select Timestamp, ServiceName, Body limit 100
-- Q42 task=top_k filter=or,minmatch freq=hi (>=2 of 4)
from index 'Logs/Search' where ((search(Body, 'error') and search(Body, 'failed')) or (search(Body, 'error') and search(Body, 'charge')) or (search(Body, 'error') and search(Body, 'cache')) or (search(Body, 'failed') and search(Body, 'charge')) or (search(Body, 'failed') and search(Body, 'cache')) or (search(Body, 'charge') and search(Body, 'cache'))) order by score() select Timestamp, ServiceName, Body limit 100
-- Q43 task=top_k filter=phrase freq=mid (phrase, 2 tokens)
from index 'Logs/Search' where search(Body, '"place order"') order by score() select Timestamp, ServiceName, Body limit 100
-- Q44 task=top_k filter=phrase freq=mid (phrase, 4 tokens)
from index 'Logs/Search' where search(Body, '"failed to place order"') order by score() select Timestamp, ServiceName, Body limit 100
-- Q45 task=top_k filter=phrase freq=lo (phrase, 8 tokens)
from index 'Logs/Search' where search(Body, '"post to email service expected 200 got 500"') order by score() select Timestamp, ServiceName, Body limit 100
-- Q46 task=top_k filter=regexp freq=mid (conn.*)
from index 'Logs/Search' where search(Body, 'conn*') order by score() select Timestamp, ServiceName, Body limit 100
-- Q47 task=top_k filter=prefix freq=hi (charg)
from index 'Logs/Search' where search(Body, 'charg*') order by score() select Timestamp, ServiceName, Body limit 100
-- Q48 task=top_k filter=fuzzy freq=mid (levenshtein distance 1)
UNSUPPORTED: fuzzy: Corax reports "Method 'Fuzzy' is not supported"
-- Q49 task=top_k filter=fuzzy freq=mid (levenshtein distance 2)
UNSUPPORTED: fuzzy: Corax reports "Method 'Fuzzy' is not supported"
-- Q50 task=top_k filter=like freq=mid (prefix wildcard conn%)
from index 'Logs/Search' where search(Body, 'conn*') order by score() select Timestamp, ServiceName, Body limit 100
-- Q51 task=top_k filter=phrase,or freq=hi (phrase OR term)
from index 'Logs/Search' where (search(Body, '"failed to place order"') or search(Body, 'charge')) order by score() select Timestamp, ServiceName, Body limit 100
-- Q52 task=top_k filter=and,negation freq=hi (error but NOT cache)
from index 'Logs/Search' where search(Body, 'error') and not (search(Body, 'cache')) order by score() select Timestamp, ServiceName, Body limit 100
-- Q53 task=top_k filter=and,window freq=hi (term + service + Timestamp BETWEEN 6h)
from index 'Logs/Search' where search(Body, 'charge') and ServiceName = 'payment' and Timestamp between '2025-09-23T00:00:00.0000000Z' and '2025-09-23T06:00:00.0000000Z' order by score() select Timestamp, ServiceName, Body limit 100
-- Q54 task=group_by filter=or freq=hi (key=SeverityText, ordered)
from index 'Logs/Search' where search(Body, 'error failed') select facet(SeverityText)
-- Q55 task=group_by filter=term freq=hi (key=SeverityText, ordered)
from index 'Logs/Search' where search(Body, 'charge') select facet(SeverityText)
-- Q56 task=group_by filter=and freq=hi (key=SeverityText, NO order by)
from index 'Logs/Search' where search(Body, 'failed order', and) select facet(SeverityText)
-- Q57 task=group_by filter=or freq=hi (key=ScopeName, top 20 ordered)
from index 'Logs/Search' where search(Body, 'error failed') select facet(ScopeName)
-- Q58 task=group_by filter=regexp freq=hi (key=ScopeName)
from index 'Logs/Search' where search(Body, 'charg*') select facet(ScopeName)
-- Q59 task=group_by filter=fuzzy freq=mid (key=ScopeName)
UNSUPPORTED: fuzzy: Corax reports "Method 'Fuzzy' is not supported"
-- Q60 task=group_by filter=or freq=hi (key=ScopeName, NO order by)
from index 'Logs/Search' where search(Body, 'error failed') select facet(ScopeName)
-- Q61 task=group_by filter=term freq=hi (key=minute)
UNSUPPORTED: date_histogram: RQL facets bucket by explicit ranges, not by calendar interval
-- Q62 task=group_by filter=and freq=hi (key=minute)
UNSUPPORTED: date_histogram: RQL facets bucket by explicit ranges, not by calendar interval
-- Q63 task=group_by filter=phrase freq=mid (key=minute)
UNSUPPORTED: date_histogram: RQL facets bucket by explicit ranges, not by calendar interval
