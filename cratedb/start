#!/usr/bin/env bash
# Launch the CrateDB container; idempotent (early-return if ./check passes).
set -euo pipefail
cd "$(dirname "$0")"
. ./_env.sh

if ./check >/dev/null 2>&1; then
    echo "CrateDB already up on :${CRATE_HTTP_PORT}"
    exit 0
fi

mkdir -p "$CRATE_DATA_DIR"

# Drop a container built from a different image, so a CRATE_IMAGE bump actually
# takes effect -- the plain `docker start` below would keep the old version.
if docker inspect "$CRATE_CONTAINER" >/dev/null 2>&1 \
   && [[ "$(docker inspect -f '{{.Config.Image}}' "$CRATE_CONTAINER")" != "$CRATE_IMAGE" ]]; then
    echo "container was built from a different image; recreating for ${CRATE_IMAGE}"
    docker rm -f "$CRATE_CONTAINER" >/dev/null
fi

if docker inspect "$CRATE_CONTAINER" >/dev/null 2>&1; then
    docker start "$CRATE_CONTAINER" >/dev/null
else
    # --network host: no NAT; CrateDB binds 4200 (HTTP) and 5432 (pg wire).
    # max_clause_count: Lucene caps a BooleanQuery at 8192 clauses. The prefix
    # family in queries.sql uses phrase_prefix WITH (max_expansions = 50000) so
    # the expansion is exhaustive and the counts match Elasticsearch exactly --
    # see the rationale in translate.py. At 1b the 'conn' and 'charg' prefixes
    # expand past 8192 and six queries died with
    #   TooManyClauses[maxClauseCount is set to 8192]
    # which the driver records as nulls, i.e. a silent failure. The setting is
    # static (SET GLOBAL rejects it: "Setting ... is not supported"), so it has
    # to be a -C node flag. 65536 clears the 50000 expansions with headroom for
    # Q24, which ANDs a fuzzy match with the prefix; keep it above
    # MAX_EXPANSIONS in translate.py.
    #
    # Note this block only runs when the container is absent or built from a
    # different image, so changing these flags on an existing container needs a
    # `docker rm -f` (./install does that, so a --index run picks them up).
    docker run -d \
        --name "$CRATE_CONTAINER" \
        --network host \
        -v "${CRATE_DATA_DIR}:/data" \
        -e "CRATE_HEAP_SIZE=${CRATE_HEAP}" \
        --ulimit memlock=-1:-1 \
        --ulimit nofile=65535:65535 \
        "$CRATE_IMAGE" \
        -Cdiscovery.type=single-node \
        -Chttp.port="${CRATE_HTTP_PORT}" \
        -Cindices.query.bool.max_clause_count=65536 >/dev/null
fi

for _ in $(seq 1 180); do
    if ./check >/dev/null 2>&1; then
        echo "CrateDB up on :${CRATE_HTTP_PORT} (backend=docker)"
        exit 0
    fi
    sleep 1
done

echo "CrateDB did not become healthy within 180s." >&2
docker logs --tail 50 "$CRATE_CONTAINER" 2>&1 >&2 || true
exit 1
